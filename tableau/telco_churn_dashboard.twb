      <column caption='Churn Rate %' datatype='real' name='[Calculation_0313504000888832]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [customer_status] = &quot;Churned&quot; THEN 1 ELSE 0 END) / COUNT([customer_id])' />
      </column>
      <column caption='Revenue Loss %' datatype='real' name='[Calculation_0313504001081345]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [customer_status] = &quot;Churned&quot; THEN [total_revenue] ELSE 0 END) / SUM([total_revenue])' />
      </column>
      <column caption='Revenue Loss ' datatype='real' name='[Calculation_0313504001212418]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [customer_status] = &quot;Churned&quot; THEN [total_revenue] ELSE 0 END)' />
